import numpy as np
import pandas as pd
from scipy.stats import poisson
 
# ── 1. Load & clean ───────────────────────────────────────────────────────────
 
df = pd.read_csv("full_wc_match_data.csv")
df = df.dropna()
print(df.isnull().sum())
 
# ── 2. Feature engineering ────────────────────────────────────────────────────
 
def normalize(col):
    std = col.std()
    return (col - col.mean()) / std if std != 0 else col * 0
 
df["home_gdp"]  = normalize(np.log(df["home_gdp"] + 1))
df["away_gdp"]  = normalize(np.log(df["away_gdp"] + 1))
df["home_pop"]  = normalize(np.log(df["home_pop"] + 1))
df["away_pop"]  = normalize(np.log(df["away_pop"] + 1))
df["home_rank"] = normalize(-np.log(df["home_rank"]))
df["away_rank"] = normalize(-np.log(df["away_rank"]))
 
# ── 3. Train / test split (temporal) ─────────────────────────────────────────
 
train_df = df[df["year"] < 2018].copy()
test_df  = df[df["year"] >= 2018].copy()
 
print(f"Train: {len(train_df)} matches | Test: {len(test_df)} matches")
 
# ── 4. Vectorized feature builder ────────────────────────────────────────────
 
def build_matrices(df):
    """Returns XH, XA (n x 8) and score arrays kH, kA."""
    ones = np.ones(len(df))
    XH = np.column_stack([
        ones,
        df["home_rank"], df["home_gdp"], df["home_pop"],
        df["away_rank"], df["away_gdp"], df["away_pop"],
        ones          # home advantage flag = 1
    ])
    XA = np.column_stack([
        ones,
        df["away_rank"], df["away_gdp"], df["away_pop"],
        df["home_rank"], df["home_gdp"], df["home_pop"],
        np.zeros(len(df))  # home advantage flag = 0
    ])
    kH = df["home_score"].values
    kA = df["away_score"].values
    return XH, XA, kH, kA
 
# ── 5. Training ───────────────────────────────────────────────────────────────
 
def train_poisson(df, epochs=500, lr=0.0001, l2=0.01):
    XH, XA, kH, kA = build_matrices(df)
    beta = np.zeros(8)
 
    for epoch in range(epochs):
        lambdaH = np.clip(np.exp(XH @ beta), 1e-5, 10)
        lambdaA = np.clip(np.exp(XA @ beta), 1e-5, 10)
 
        grad = (kH - lambdaH) @ XH + (kA - lambdaA) @ XA
        grad -= l2 * beta  # L2 regularization to keep weights small
 
        # gradient clipping so we don't get runaway updates
        grad_norm = np.linalg.norm(grad)
        if grad_norm > 1.0:
            grad /= grad_norm
 
        beta += lr * grad
 
    return beta
 
# ── 6. Prediction helpers ─────────────────────────────────────────────────────
 
def match_outcome_probs(lambdaH, lambdaA, max_goals=10):
    """Joint Poisson probability for home win / draw / away win."""
    goals = np.arange(max_goals + 1)
    pH    = poisson.pmf(goals, lambdaH)   # fixes the factorial-on-float bug
    pA    = poisson.pmf(goals, lambdaA)
    joint = np.outer(pH, pA)              # (11 x 11) joint score matrix
 
    P_home = np.tril(joint, -1).sum()
    P_draw = np.trace(joint)
    P_away = np.triu(joint, 1).sum()
    return P_home, P_draw, P_away
 
def predict_lambdas(beta, row):
    xH = np.array([1, row["home_rank"], row["home_gdp"], row["home_pop"],
                      row["away_rank"], row["away_gdp"], row["away_pop"], 1])
    xA = np.array([1, row["away_rank"], row["away_gdp"], row["away_pop"],
                      row["home_rank"], row["home_gdp"], row["home_pop"], 0])
    return np.exp(beta @ xH), np.exp(beta @ xA)
 
def get_actual_result(row):
    if row["home_score"] > row["away_score"]:
        return 0   # home win
    elif row["home_score"] == row["away_score"]:
        return 1   # draw
    else:
        return 2   # away win
 
# ── 7. Evaluation ─────────────────────────────────────────────────────────────
 
def compute_accuracy(df, beta):
    correct = 0
    for _, row in df.iterrows():
        lH, lA = predict_lambdas(beta, row)
        pred   = np.argmax(match_outcome_probs(lH, lA))
        if pred == get_actual_result(row):
            correct += 1
    return correct / len(df)
 
# ── 8. Run ────────────────────────────────────────────────────────────────────
 
beta = train_poisson(train_df)
print("Beta:", beta)
 
train_acc = compute_accuracy(train_df, beta)
test_acc  = compute_accuracy(test_df, beta)
 
print(f"Train accuracy: {train_acc:.4f}")
print(f"Test accuracy:  {test_acc:.4f}")
